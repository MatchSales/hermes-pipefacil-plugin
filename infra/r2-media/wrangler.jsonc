{
  "name": "hermes-sdr-media",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{"binding": "MEDIA_BUCKET", "bucket_name": "hermes-sdr-media"}],
  "secrets": {"required": ["UPLOAD_TOKENS_JSON"]},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {"enabled": true, "invocation_logs": false}
  }
}
